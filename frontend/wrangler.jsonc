// A static-assets Worker: no script, just the Vite build. Workers Builds runs
// `pnpm install --frozen-lockfile && pnpm build` from this directory, then `wrangler deploy`
// (spec §8; the Cloudflare runbook wires the build and the custom domain).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fundlens",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./dist",
    // Any path that is not a built file gets index.html, so React Router owns client-side routes.
    "not_found_handling": "single-page-application"
  }
}
