        "number",
        "null"
      ],
      "x-duckdb-type": "DECIMAL(14,2)"
    },
    "debts_owed_to": {
      "description": "Null; `weball` does not give it.",
      "type": [
        "number",
        "null"
      ],
      "x-duckdb-type": "DECIMAL(14,2)"
    },
    "individual_itemized": {
      "description": "Null; `weball` does not split itemized from unitemized money.",
      "type": [
        "number",
        "null"
      ],
      "x-duckdb-type": "DECIMAL(14,2)"
    },
    "individual_unitemized": {
