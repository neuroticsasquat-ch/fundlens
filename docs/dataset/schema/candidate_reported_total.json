      "type": [
        "number",
        "null"
      ],
      "x-duckdb-type": "DECIMAL(14,2)"
    },
    "independent_expenditures": {
      "description": "Null; `weball` does not give it.",
      "type": [
        "number",
        "null"
      ],
      "x-duckdb-type": "DECIMAL(14,2)"
    },
    "party_coordinated": {
      "description": "Null; `weball` does not give it.",
      "type": [
        "number",
        "null"
      ],
      "x-duckdb-type": "DECIMAL(14,2)"
