    "period_start",
    "period_end",
    "receipts",
    "disbursements",
    "cash_on_hand_start",
    "cash_on_hand_end",
    "debts_owed_by",
    "debts_owed_to",
    "individual_itemized",
    "individual_unitemized",
    "individual_total",
    "individual_refunds",
    "party_contributions",
    "other_committee_contributions",
    "candidate_contributions",
    "candidate_loans",
