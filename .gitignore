# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test / lint / type-check caches and reports
.pytest_cache/
.ruff_cache/
.pyright/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Virtual environments (Docker-only dev, but guard against strays)
.venv/
venv/
.python-version

# Secrets / local env -- commit .env.example, never .env
.env
.env.*
!.env.example

# Local data (the real copies live in R2 and Postgres)
/data/
*.duckdb
*.duckdb.wal
*.parquet
!tests/fixtures/**/*.parquet

# Frontend (frontend/.gitignore covers dist/ and .wrangler/ too)
node_modules/

# Logs
*.log

# Editors and OS
.idea/
.vscode/
*.swp
*~
.DS_Store
